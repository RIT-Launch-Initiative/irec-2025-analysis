clear;
close all;

%% Constants and Unit Conversions
ft_to_m       = 0.3048;          % Feet to meters
lbft2_to_kgm2 = 1.35581795;       % lb-ft² to kg-m²
oz_to_kg      = 0.0283495;        % Ounces to kilograms
in_to_m       = 0.0254;           % Inches to meters
in2_to_m2     = 0.00064516;       % Square inches to square meters

%% Read Data from CSV
csv_file_path = 'C:\Users\kyle1\Downloads\Kyle_wind_tunnel_OMEN.CSV';
data = readtable(csv_file_path);

% Extract time and angle of attack data
time_array = data.Time_sec_;
time_array = round(time_array, 3);  % Round to 3 decimal places
A_array = data.AngleOfAttack_deg_;

%% Limit Data to the Desired Time Interval
valid_indices = (time_array >= 1.01) & (time_array <= 5.15);
time_array = time_array(valid_indices);
A_array    = A_array(valid_indices);

%% Plot Raw Data with Tolerance Lines
figure;
plot(time_array, A_array, 'g', 'LineWidth', 1.5);
xlabel('Time (s)');
ylabel('Angle of Attack (\alpha) [degrees]');
title('Raw Angle of Attack Data');
grid on;
hold on;

%% Compute Response Metrics Directly from Raw Data

% --- Final Value ---
% Average the last 10% of the data to smooth out noise.
n_final = max(1, round(0.1 * length(A_array)));
final_val = mean(A_array(end - n_final + 1 : end));

% --- Initial Value ---
initial_val = A_array(1);

% Determine the step direction (upward if final > initial, downward otherwise)
if final_val >= initial_val
    level10 = initial_val + 0.1 * (final_val - initial_val);
    level90 = initial_val + 0.9 * (final_val - initial_val);
    idx10 = find(A_array >= level10, 1, 'first');
    idx90 = find(A_array >= level90, 1, 'first');
else
    level10 = initial_val - 0.1 * (initial_val - final_val);
    level90 = initial_val - 0.9 * (initial_val - final_val);
    idx10 = find(A_array <= level10, 1, 'first');
    idx90 = find(A_array <= level90, 1, 'first');
end

if ~isempty(idx10) && ~isempty(idx90)
    rise_time = time_array(idx90) - time_array(idx10);
else
    rise_time = NaN;
end

% --- Peak Time and Peak Value ---
if final_val >= initial_val
    [peak_val, idx_peak] = max(A_array);
else
    [peak_val, idx_peak] = min(A_array);
end
peak_time = time_array(idx_peak);

% --- Overshoot ---
if final_val >= initial_val
    if peak_val > final_val
        overshoot = (peak_val - final_val) / (final_val - initial_val) * 100;
    else
        overshoot = 0;
    end
else
    if peak_val < final_val
        overshoot = (final_val - peak_val) / (initial_val - final_val) * 100;
    else
        overshoot = 0;
    end
end

% --- Undershoot ---
if final_val >= initial_val
    min_val = min(A_array);
    if min_val < final_val
        undershoot = (final_val - min_val) / (final_val - initial_val) * 100;
    else
        undershoot = 0;
    end
else
    max_val = max(A_array);
    if max_val > final_val
        undershoot = (max_val - final_val) / (initial_val - final_val) * 100;
    else
        undershoot = 0;
    end
end

% --- Settling Time ---
% Settling time is defined as the time after which the response remains within a specified 
% tolerance band of the final value. Here, we use a 5% tolerance of the step height.
tolerance = 0.02;
step_height = abs(final_val - initial_val);
band = tolerance * step_height;
settling_time = NaN;
for k = 1:length(A_array)
    if all(abs(A_array(k:end) - final_val) <= band)
        settling_time = time_array(k);
        break;
    end
end

%% Add Tolerance Band Lines to the Plot
y_upper = final_val + band;
y_lower = final_val - band;
plot([time_array(1) time_array(end)], [y_upper y_upper], 'r--', 'LineWidth', 1);
plot([time_array(1) time_array(end)], [y_lower y_lower], 'r--', 'LineWidth', 1);
legend('Raw AOA', 'Upper Tolerance', 'Lower Tolerance');

%% Display the Computed Metrics
fprintf('\nResponse Metrics from Raw Data:\n');
fprintf('Initial Value: %.4f\n', initial_val);
fprintf('Final Value: %.4f\n', final_val);
fprintf('Rise Time (10%% to 90%%): %.4f seconds\n', rise_time);
fprintf('Peak Time: %.4f seconds\n', peak_time);
fprintf('Overshoot: %.2f%%\n', overshoot);
fprintf('Undershoot: %.2f%%\n', undershoot);
fprintf('Settling Time: %.4f seconds\n', settling_time);

function [stabWindData,timeToStab] = stabWindTemp (windSpeeds,otis_path,simName)
      
    nSims = numel(windSpeeds);

    % Initialize OpenRocket
    otis = openrocket(otis_path);
    sim = otis.sims(simName);
    opts = sim.getOptions();
    
    % Preallocate master data matrix
    stabWindData = zeros(nSims, nTemps + 1);  % +1 for wind speed column
    stabWindData(:,1) = windSpeeds';  % Transpose to column vector

    timeToStab = zeros(nSims,1);
    
    % Simulation loop
    for jWind = 1:nSims

        % Configure simulation
        opts.setWindSpeedAverage(windSpeeds(jWind));
        
        % Run simulation and get data
        iSim = openrocket.simulate(sim, outputs="ALL");
        data = openrocket.get_data(sim);
        
        %trim data
        data_range = timerange(eventfilter("LAUNCHROD"), eventfilter("BURNOUT"), "openleft");
        data = data(data_range, :);
            
        % Check stability margin and time
        stabilityMargin = data{:, 'Stability margin'};
    
        % Store stability margin at launchrod
        stabOffRod(jWind) = stabilityMargin(1,1);
           
        
        if stabOffRod(jWind) >= 1.5
            timeToStability(jWind,1) = 0;
        else
            timeToStability(jWind,1) = stabOffRod(jWind); 
            % Define the subarray starting at index 127
            marginSubarray = stabilityMargin(1:end);
            timeSubarray = seconds(data.Time(1:end));
        
            % Find the index range where stabilityMargin crosses 1.5
            if any(marginSubarray >= 1.5)
                % Use interp1 to find the exact time where stabilityMargin reaches 1.5
                timeToStability(jWind,1) = (interp1(marginSubarray, timeSubarray, 1.5))-(timeSubarray(1,1));
            else
                timeToStability(jWind) = NaN;  % No stability achieved
            end
    
        end

        timeToStability(jWind,2) = windSpeeds(jWind);
    
        
        disp = 'Stability %4.3f cal, at temp %4.1f C, at wind speed %4.1f, sim number %4.0f, time to stability: %4.3f s\n';
        fprintf(disp, stabOffRod(jWind, 1), tSet, windSpeeds(jWind), jWind, timeToStability(jWind,2));
    end
    % Store results in corresponding temperature column
    stabWindData(:, jWind + 1) = stabOffRod;
end


